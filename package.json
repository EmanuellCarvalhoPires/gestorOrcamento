{
  "name": "simple-finances",
  "productName": "Simple Finances",
  "version": "1.1.3",
  "description": "Simple Finances - Gestão Financeira Pessoal",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "node -e \"try { require('fs').rmSync('out', { recursive: true, force: true }); } catch (e) {}\" && electron-forge make",
    "build": "electron-forge package",
    "build:nsis": "npm run build && electron-builder --config electron-builder.json",
    "dist": "npm run build:nsis",
    "release": "npm run build && electron-builder --config electron-builder.json --publish always",
    "publish": "electron-forge publish",
    "lint": "echo \"No linting configured\""
  },
  "keywords": [],
  "author": {
    "name": "Emanuell",
    "email": "emanuell.carvalho.pires@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-appx": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "omggif": "^1.0.10",
    "png-to-ico": "^3.0.2",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.8.9",
    "nodemailer": "^9.0.4",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "overrides": {
    "tar": "^7.5.21",
    "tmp": "^0.2.6"
  }
}